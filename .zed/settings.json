{
  "languages": {
    "JSON": {
      "language_servers": ["json-language-server", "dtcg-tokens-lsp"]
    }
  },
  "lsp": {
    "json-language-server": {
      "settings": {
        "json": {
          "schemas": [
            {
              "fileMatch": [
                "example.json",
                "*.tokens",
                "*.tokens.json",
                "app/token-playground/src/demo-tokens.json"
              ],
              "url": "./schema.json"
            }
          ]
        }
      }
    },
    "dtcg-tokens-lsp": {
      "binary": {
        "path": "node",
        "arguments": ["./lsp/dist/server.js", "--stdio"]
      }
    },
    "vtsls": {
      "initialization_options": {
        "preferences": {
          "autoImportSpecifierExcludeRegexes": ["^(node:)?os$"]
        }
      }
    }
  }
}
