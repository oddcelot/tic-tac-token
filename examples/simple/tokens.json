{
  "$schema": "./node_modules/@oddsquad/tic-tac-token/schema.json",
  "color": {
    "$type": "color",
    "brand": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2, 0.4, 1],
        "alpha": 1,
        "hex": "#3366ff"
      }
    },
    "brand-hover": {
      "$value": "{color.brand}"
    }
  },
  "gradient": {
    "hero": {
      "$type": "gradient",
      "$value": [
        { "color": "{color.brand}", "position": -0.2 },
        { "color": "{color.brand-hover}", "position": 1.4 }
      ]
    }
  }
}
