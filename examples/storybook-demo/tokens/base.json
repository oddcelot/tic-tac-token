{
  "$schema": "/schema.json",
  "spacing": {
    "card": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": {
        "value": 12,
        "unit": "px"
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ]
      },
      "serif": {
        "$type": "fontFamily",
        "$value": [
          "Georgia",
          "Times New Roman",
          "serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "SFMono-Regular",
          "monospace"
        ]
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": "regular"
      },
      "medium": {
        "$type": "fontWeight",
        "$value": "medium"
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": "semi-bold"
      },
      "bold": {
        "$type": "fontWeight",
        "$value": "bold"
      },
      "black": {
        "$type": "fontWeight",
        "$value": "black"
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "base": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "xl": {
        "$type": "dimension",
        "$value": {
          "value": 28,
          "unit": "px"
        }
      },
      "2xl": {
        "$type": "dimension",
        "$value": {
          "value": 44,
          "unit": "px"
        }
      }
    }
  }
}
