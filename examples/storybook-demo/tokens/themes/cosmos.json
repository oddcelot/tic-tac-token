{
  "$schema": "/schema.json",
  "color": {
    "primary": {
      "$type": "color",
      "$value": "{color.cosmos.indigo}",
      "$extensions": {
        "tic-tac-token.modes": {
          "dark": {
            "colorSpace": "srgb",
            "components": [0.55, 0.58, 1],
            "alpha": 1,
            "hex": "#8C94FF"
          }
        }
      }
    },
    "accent": {
      "$type": "color",
      "$value": "{color.cosmos.rose}",
      "$extensions": {
        "tic-tac-token.modes": {
          "dark": {
            "colorSpace": "srgb",
            "components": [1, 0.45, 0.62],
            "alpha": 1,
            "hex": "#FF739E"
          }
        }
      }
    },
    "background": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0.98, 0.97, 1], "alpha": 1, "hex": "#FAF8FF" },
      "$extensions": {
        "tic-tac-token.modes": {
          "dark": {
            "colorSpace": "srgb",
            "components": [0.06, 0.08, 0.16],
            "alpha": 1,
            "hex": "#0F1428"
          }
        }
      }
    },
    "surface": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1, "hex": "#FFFFFF" },
      "$extensions": {
        "tic-tac-token.modes": {
          "dark": {
            "colorSpace": "srgb",
            "components": [0.1, 0.13, 0.22],
            "alpha": 1,
            "hex": "#1A2036"
          }
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0.1, 0.11, 0.13], "alpha": 1, "hex": "#1A1D21" },
      "$extensions": {
        "tic-tac-token.modes": {
          "dark": {
            "colorSpace": "srgb",
            "components": [0.91, 0.92, 0.96],
            "alpha": 1,
            "hex": "#E8EAF5"
          }
        }
      }
    },
    "cosmos": {
      "indigo": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.32, 0.36, 0.9],
          "alpha": 1,
          "hex": "#525CE6"
        },
        "$extensions": {
          "tic-tac-token.modes": {
            "dark": {
              "colorSpace": "srgb",
              "components": [0.55, 0.58, 1],
              "alpha": 1,
              "hex": "#8C94FF"
            }
          }
        }
      },
      "rose": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9, 0.24, 0.42],
          "alpha": 1,
          "hex": "#E63D6B"
        },
        "$extensions": {
          "tic-tac-token.modes": {
            "dark": {
              "colorSpace": "srgb",
              "components": [1, 0.45, 0.62],
              "alpha": 1,
              "hex": "#FF739E"
            }
          }
        }
      }
    }
  },
  "spacing": {
    "card": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "radius": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["Inter", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"]
      },
      "serif": {
        "$type": "fontFamily",
        "$value": ["Georgia", "Times New Roman", "serif"]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "monospace"]
      }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": "regular" },
      "medium": { "$type": "fontWeight", "$value": "medium" },
      "semibold": { "$type": "fontWeight", "$value": "semi-bold" },
      "bold": { "$type": "fontWeight", "$value": "bold" },
      "black": { "$type": "fontWeight", "$value": "black" }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
      "sm": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
      "base": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "lg": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
      "xl": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } },
      "2xl": { "$type": "dimension", "$value": { "value": 44, "unit": "px" } }
    }
  }
}