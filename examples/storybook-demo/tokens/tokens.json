{
  "$schema": "/schema.json",
  "color": {
    "astro": {
      "teal": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.05, 0.6, 0.55],
          "alpha": 1,
          "hex": "#0D998C"
        },
        "$extensions": {
          "tic-tac-token.modes": {
            "dark": {
              "colorSpace": "srgb",
              "components": [0.2, 0.78, 0.72],
              "alpha": 1,
              "hex": "#33C7B8"
            }
          }
        }
      },
      "orange": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.95, 0.45, 0.15],
          "alpha": 1,
          "hex": "#F27326"
        },
        "$extensions": {
          "tic-tac-token.modes": {
            "dark": {
              "colorSpace": "srgb",
              "components": [1, 0.66, 0.35],
              "alpha": 1,
              "hex": "#FFA859"
            }
          }
        }
      }
    },
    "cosmos": {
      "indigo": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.32, 0.36, 0.9],
          "alpha": 1,
          "hex": "#525CE6"
        },
        "$extensions": {
          "tic-tac-token.modes": {
            "dark": {
              "colorSpace": "srgb",
              "components": [0.55, 0.58, 1],
              "alpha": 1,
              "hex": "#8C94FF"
            }
          }
        }
      },
      "rose": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9, 0.24, 0.42],
          "alpha": 1,
          "hex": "#E63D6B"
        },
        "$extensions": {
          "tic-tac-token.modes": {
            "dark": {
              "colorSpace": "srgb",
              "components": [1, 0.45, 0.62],
              "alpha": 1,
              "hex": "#FF739E"
            }
          }
        }
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ]
      },
      "serif": {
        "$type": "fontFamily",
        "$value": ["Georgia", "Times New Roman", "serif"]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "monospace"]
      }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": "regular" },
      "medium": { "$type": "fontWeight", "$value": "medium" },
      "semibold": { "$type": "fontWeight", "$value": "semi-bold" },
      "bold": { "$type": "fontWeight", "$value": "bold" },
      "black": { "$type": "fontWeight", "$value": "black" }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
      "sm": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
      "base": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "lg": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
      "xl": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } },
      "2xl": { "$type": "dimension", "$value": { "value": 44, "unit": "px" } }
    }
  }
}