{
  "name": "@oddsquad/tic-tac-token-lsp",
  "version": "0.1.0",
  "description": "Language server for DTCG 2025.10 design-tokens files. Diagnostics, hover, and (soon) navigation/completion for .tokens.json and .tokens files.",
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "dtcg-tokens-lsp": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./browser": {
      "types": "./dist/server-browser.d.ts",
      "import": "./dist/server-browser.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oddcelot/tic-tac-token.git",
    "directory": "lsp"
  },
  "homepage": "https://github.com/oddcelot/tic-tac-token/tree/main/lsp#readme",
  "bugs": {
    "url": "https://github.com/oddcelot/tic-tac-token/issues"
  },
  "author": "Stefan Kopco",
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dtcg",
    "design-tokens",
    "language-server",
    "lsp",
    "vscode"
  ],
  "license": "ISC",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit",
    "build:dist": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm -C .. build:dist && pnpm build:dist && pnpm test"
  },
  "dependencies": {
    "@oddsquad/tic-tac-token": "workspace:*",
    "jsonc-parser": "^3.3.1",
    "vscode-languageserver": "^10.1.1",
    "vscode-languageserver-textdocument": "^1.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
