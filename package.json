{
  "name": "@oddsquad/tic-tac-token",
  "version": "0.1.0",
  "description": "Runtime validator for the Design Tokens Format Module (DTCG) 2025.10. Standard-Schema-compatible, arktype-backed.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resolver": {
      "types": "./dist/resolver/index.d.ts",
      "import": "./dist/resolver/index.js"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "import": "./dist/css.js"
    },
    "./schema.json": "./schema.json"
  },
  "files": [
    "dist",
    "schema.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dtcg",
    "design-tokens",
    "design-tokens-format",
    "arktype",
    "standard-schema",
    "validator",
    "json-schema"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oddcelot/tic-tac-token.git"
  },
  "homepage": "https://github.com/oddcelot/tic-tac-token#readme",
  "bugs": {
    "url": "https://github.com/oddcelot/tic-tac-token/issues"
  },
  "author": "Stefan Kopco",
  "engines": {
    "node": ">=26"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run tests",
    "test:watch": "vitest",
    "build": "tsc --noEmit",
    "build:dist": "tsc -p tsconfig.build.json",
    "generate-schema": "node generate-schema.ts",
    "build:packages": "pnpm build:dist && pnpm -F @oddsquad/tic-tac-token-lsp build:dist",
    "prepublishOnly": "pnpm test && pnpm generate-schema && pnpm build:dist"
  },
  "dependencies": {
    "arktype": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.4"
  }
}
