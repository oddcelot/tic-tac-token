{
  "$schema": "/schema.json",
  "color": {
    "brand": {
      "blue": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.13, 0.42, 0.93],
          "alpha": 1,
          "hex": "#216BED"
        },
        "$extensions": {
          "tic-tac-token.modes": {
            "dark": {
              "colorSpace": "srgb",
              "components": [0.42, 0.7, 1],
              "alpha": 1,
              "hex": "#6BB3FF"
            }
          }
        }
      },
      "violet": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.42, 0.31, 0.9],
          "alpha": 1,
          "hex": "#6C4FE5"
        },
        "$extensions": {
          "tic-tac-token.modes": {
            "dark": {
              "colorSpace": "srgb",
              "components": [0.56, 0.47, 1],
              "alpha": 1,
              "hex": "#8F78FF"
            }
          }
        }
      },
      "pink": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 0.4, 0.5],
          "alpha": 1,
          "hex": "#FF6680"
        },
        "$extensions": {
          "tic-tac-token.modes": {
            "dark": {
              "colorSpace": "srgb",
              "components": [1, 0.56, 0.64],
              "alpha": 1,
              "hex": "#FF8FA3"
            }
          }
        }
      }
    },
    "neutral": {
      "bg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.97, 0.97, 0.98],
          "alpha": 1,
          "hex": "#F7F7F9"
        },
        "$extensions": {
          "tic-tac-token.modes": {
            "dark": {
              "colorSpace": "srgb",
              "components": [0.08, 0.09, 0.12],
              "alpha": 1,
              "hex": "#14161F"
            }
          }
        }
      },
      "bg-elevated": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "alpha": 1,
          "hex": "#FFFFFF"
        },
        "$extensions": {
          "tic-tac-token.modes": {
            "dark": {
              "colorSpace": "srgb",
              "components": [0.13, 0.15, 0.2],
              "alpha": 1,
              "hex": "#212630"
            }
          }
        }
      },
      "text": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.08, 0.09, 0.12],
          "alpha": 1,
          "hex": "#14161F"
        },
        "$extensions": {
          "tic-tac-token.modes": {
            "dark": {
              "colorSpace": "srgb",
              "components": [0.95, 0.96, 0.97],
              "alpha": 1,
              "hex": "#F2F4F7"
            }
          }
        }
      },
      "text-muted": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.42, 0.44, 0.48],
          "alpha": 1,
          "hex": "#6B7078"
        },
        "$extensions": {
          "tic-tac-token.modes": {
            "dark": {
              "colorSpace": "srgb",
              "components": [0.61, 0.63, 0.67],
              "alpha": 1,
              "hex": "#9CA1A9"
            }
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.86, 0.87, 0.89],
          "alpha": 1,
          "hex": "#D9DCE1"
        },
        "$extensions": {
          "tic-tac-token.modes": {
            "dark": {
              "colorSpace": "srgb",
              "components": [0.22, 0.24, 0.29],
              "alpha": 1,
              "hex": "#383E48"
            }
          }
        }
      }
    },
    "semantic": {
      "success": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.08, 0.67, 0.36], "alpha": 1, "hex": "#14AB5C" } },
      "warning": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.96, 0.62, 0.09], "alpha": 1, "hex": "#F59E17" } },
      "danger": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.87, 0.21, 0.28], "alpha": 1, "hex": "#DE3646" } }
    },
    "alias": {
      "surface": { "$type": "color", "$value": "{color.neutral.bg}" },
      "border-on-elevated": { "$type": "color", "$value": "{color.neutral.border}" }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["Inter", "ui-sans-serif", "system-ui", "-apple-system", "sans-serif"]
      },
      "serif": {
        "$type": "fontFamily",
        "$value": ["Georgia", "Times New Roman", "serif"]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "monospace"]
      }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": "regular" },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": "bold" },
      "black": { "$type": "fontWeight", "$value": 900 }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": { "value": 0.75, "unit": "rem" } },
      "sm": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } },
      "base": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
      "lg": { "$type": "dimension", "$value": { "value": 1.25, "unit": "rem" } },
      "xl": { "$type": "dimension", "$value": { "value": 1.75, "unit": "rem" } },
      "2xl": { "$type": "dimension", "$value": { "value": 2.75, "unit": "rem" } }
    }
  }
}